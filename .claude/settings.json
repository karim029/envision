{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "outputStyle": "Learning",
  "permissions": {
    "deny": [
      "Bash(npx prisma db push *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Edit(/src/server/**)",
      "Edit(/src/app/**)",
      "Edit(/src/lib/supabase/**)",
      "Edit(/src/proxy.ts)",
      "Edit(/src/env*.ts)",
      "Edit(/src/worker/**)",
      "Edit(/prisma/schema.prisma)",
      "Edit(/prisma/migrations/**)"
    ],
    "allow": [
      "Bash(npm run format:check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:unit *)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:integration *)",
      "Bash(npm run test:integration)",
      "Bash(npm run build)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ]
  }
}
