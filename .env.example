# Copy to .env and fill in. Keys only; never put real secrets in this file.
# Local values below match docker-compose.yml.

# Runtime queries (Supabase: transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/envision"
# Prisma CLI / migrations (Supabase: direct connection, port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/envision"

# Integration tests (must end in _test: the suite truncates every table)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/envision_test"
