// Single source of truth for the database. Change it, then run:
//   npx prisma migrate dev --name <name>   (never `db push`)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  DEMO
  PRO
}

enum UserRole {
  ADMIN
  MEMBER
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  GRADED
  GRADING_FAILED
}

enum HrLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
}

model Tenant {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  planTier       PlanTier @default(DEMO)
  minutesBalance Int      @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  sessions    InterviewSession[]
  evaluations HrEvaluation[]
  invite      Invite? // the invite this tenant signed up with (beta only)
}

// Single-use signup invite for the invite-only beta. PLATFORM-level, not tenant-owned:
// it exists before any tenant does, so it has no tenantId. Only the owner's
// `npm run invite:create` script creates these; onboardTenant consumes them.
// Removal path after the beta: drop the claim step in onboardTenant + one migration.
model Invite {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique // SHA-256 hex of the token; the token itself is never stored
  label          String // who it was sent to, e.g. "Sara, People Ops @ Acme"
  expiresAt      DateTime
  usedAt         DateTime?
  usedByTenantId String?   @unique @db.Uuid
  createdAt      DateTime  @default(now())

  usedByTenant Tenant? @relation(fields: [usedByTenantId], references: [id], onDelete: SetNull)
}

model User {
  id        String   @id @db.Uuid // = Supabase auth.users.id (no default: Supabase creates it)
  tenantId  String   @db.Uuid
  email     String   @unique
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions InterviewSession[]

  @@index([tenantId])
}

model InterviewSession {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  userId    String        @db.Uuid
  status    SessionStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  evaluation HrEvaluation?

  @@index([tenantId])
  @@index([userId, status]) // "max 1 active session per user" lookup (Chunk 4)
}

model HrEvaluation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  sessionId String   @unique @db.Uuid
  level     HrLevel
  createdAt DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
